      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (increase(backup_operator_attempt_failures_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{reason}}",
          "refId": "U"
